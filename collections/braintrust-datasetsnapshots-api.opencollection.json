            "params": [
              {
                "name": "dataset_snapshot_id",
                "value": "",
                "type": "path",
                "description": "DatasetSnapshot id"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a dataset_snapshot object by its id"
