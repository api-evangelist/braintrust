                "description": "DatasetSnapshot id"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a dataset_snapshot object by its id"
        },
        {
          "info": {
            "name": "Partially update dataset_snapshot",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
