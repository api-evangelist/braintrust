{
  "opencollection": "1.0.0",
  "info": {
    "name": "Braintrust Acls Other API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Other",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Hello world endpoint",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.braintrust.dev/v1"
          },
          "docs": "Default endpoint. Simply replies with 'Hello, World!'. Authorization is not required"
        }
      ]
    }
  ],
  "bundled": true
}